# Required Instagram / Meta credentials for live publishing.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional Hugging Face token for provider-first video/image generation.
HF_TOKEN=

# Core runtime settings.
TIMEZONE=America/New_York
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
ENABLE_YOUTUBE_TRANSCRIPTS=true
ENABLE_VIDEO_PROVIDER=false
ENABLE_LOCAL_FALLBACK=true
POSTS_PER_DAY=5
BATCH_RENDER_SIZE=5
DRY_RUN=true
LOG_LEVEL=INFO
PUBLICATION_START_HOUR=8
PUBLICATION_END_HOUR=22

# Optional overrides.
DATABASE_PATH=output/content_machine.db
# Optional Turso/libSQL remote database.
# If set with TURSO_AUTH_TOKEN, the app uses a separate local embedded replica file
# next to DATABASE_PATH and syncs it with the remote Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL_SECONDS=300
SOURCE_CONFIG_PATH=app/source_ingest/source_definitions.json
OUTPUT_DIR=output
ASSETS_DIR=assets
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
REQUEST_TIMEOUT_SECONDS=25
PROVIDER_TIMEOUT_SECONDS=90
META_GRAPH_API_VERSION=v19.0

# Meta requires a publicly reachable video URL for non-dry-run publishing.
# Free local mode: run scripts/serve_media_public.sh, then paste the temporary
# https://*.trycloudflare.com URL here while the tunnel stays open.
# R2 mode: point this at your public bucket/custom-domain base URL.
PUBLIC_MEDIA_BASE_URL=
MEDIA_STAGING_DIR=output/published/staged
DELETE_STAGED_MEDIA_AFTER_PUBLISH=true

# Optional Cloudflare R2 storage for GitHub-hosted publishing. Leave these blank
# for the strict-free local tunnel path.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=
R2_REGION=auto

# Local TTS options.
PIPER_MODEL_PATH=
PIPER_VOICE=
MACOS_SAY_VOICE=Samantha
LINUX_TTS_VOICE=en-us
ENABLE_GTTS_FALLBACK=false

# Optional caption / music tuning.
DEFAULT_CTA=Follow for daily internship and new-grad reels.
MAX_SOURCE_ITEMS_PER_INGEST=20
